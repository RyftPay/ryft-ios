# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  
  lane :lint do
    swiftlint(mode: :lint, strict: true)
  end

  lane :lint_autocorrect do
    swiftlint(mode: :autocorrect)
  end

  lane :tests do
    core_test
    card_test
    ui_unit_test
    ui_test
  end

  lane :card_test do
    run_tests(
      workspace: "ryft-ios.xcodeproj/project.xcworkspace",
      scheme: "RyftCard",
      devices: ["iPhone 16"]
    )
  end

  lane :core_test do
    run_tests(
      workspace: "ryft-ios.xcodeproj/project.xcworkspace",
      scheme: "RyftCore",
      devices: ["iPhone 16"]
    )
  end

  lane :ui_unit_test do
    run_tests(
      workspace: "ryft-ios.xcodeproj/project.xcworkspace",
      scheme: "RyftUI",
      devices: ["iPhone 16"]
    )
  end

  lane :ui_test do
    run_tests(
      workspace: "ryft-ios.xcodeproj/project.xcworkspace",
      scheme: "RyftUITestApp",
      devices: ["iPhone 16"],
      derived_data_path: "scan_derived_data",
      reset_simulator: true,
      # Boot the simulator before testing so the XCUITest runner handshake doesn't
      # time out "while preparing to run tests" on a cold-booted CI simulator.
      prelaunch_simulator: true,
      # Retry once to absorb transient simulator/runner preparation timeouts on CI.
      number_of_retries: 1
    )
  end

  #todo: add lane to bump and tag new version

end
